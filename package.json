{
  "name": "millefleurs-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run dev",
    "test": "tsx --test tests/*.test.ts",
    "data:import": "tsx server/import-cli.ts",
    "db:backup": "tsx server/backup.ts",
    "spec:validate": "openspec validate --all --strict",
    "format": "prettier --write src worker functions scripts/cloud server shared tests vite.config.ts",
    "format:check": "prettier --check src worker functions scripts/cloud server shared tests vite.config.ts",
    "data:update-images": "tsx server/update-image-urls.ts",
    "cloud:catalog": "tsx scripts/cloud/catalog.ts",
    "cloud:setup:local": "wrangler d1 migrations apply DB --local && npm run cloud:catalog && wrangler d1 execute DB --local --file .runtime/cloud/catalog.sql && wrangler d1 execute DB --local --file .runtime/cloud/activate-catalog.sql",
    "cloud:configure": "tsx scripts/cloud/configure.ts",
    "cloud:deploy:pages": "tsx scripts/cloud/deploy-pages.ts",
    "cloud:deploy": "tsx scripts/cloud/deploy.ts",
    "cloud:migrate-legacy": "tsx scripts/cloud/migrate-legacy.ts",
    "test:browser": "npm run build && tsx tests/browser.e2e.ts",
    "test:runtime": "wrangler deploy --dry-run --outdir .runtime/worker-build && wrangler pages functions build --outdir .runtime/pages-build && tsx tests/runtime.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@hono/node-server": "2.1.1",
    "csv-parse": "7.0.2",
    "firebase": "12.18.0",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "lucide-react": "1.41.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@fission-ai/openspec": "1.12.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsqr": "1.4.0",
    "miniflare": "5.20260907.0-alpha",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
