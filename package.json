{
  "name": "milleflewrs-order",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "data:import": "tsx server/import-cli.ts",
    "db:backup": "tsx server/backup.ts",
    "spec:validate": "openspec validate add-home-cocktail-ordering --strict"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "csv-parse": "7.0.2",
    "hono": "4.13.7",
    "lucide-react": "1.41.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "@types/node": "26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
