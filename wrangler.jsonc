{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "milleflewrs-api-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_ENV": "local", "PUBLIC_APP_URL": "http://localhost:5173", "FIREBASE_PROJECT_ID": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "milleflewrs-local", "database_id": "local", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
